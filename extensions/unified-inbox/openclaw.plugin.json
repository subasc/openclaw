{
  "id": "unified-inbox",
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "enabled": { "type": "boolean" },
      "authMode": { "type": "string", "enum": ["browser", "device-code"], "default": "browser" },
      "browserProfile": { "type": "string", "default": "openclaw" },
      "telegramChatId": { "type": "string" },
      "telegramBotToken": { "type": "string" },
      "telegramAccountId": { "type": "string" },
      "microsoft": { "type": "object" },
      "email": { "type": "object" },
      "calendar": { "type": "object" },
      "teamsChat": { "type": "object" },
      "whatsapp": { "type": "object" },
      "replyTracking": { "type": "object" }
    }
  }
}
